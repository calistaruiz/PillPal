# Copy to .env and fill in. Never commit .env.

# Claude API key from https://console.anthropic.com/
# Leave blank to run in demo mode (sample medication list, no AI calls).
ANTHROPIC_API_KEY=

# Optional: raises openFDA rate limits. Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Optional overrides
# PILLPAL_MODEL=claude-opus-5-5
# PILLPAL_DEMO_MODE=true
# Comma-separated list of frontend URLs allowed to call the API (add your Vercel URL when deployed)
# FRONTEND_ORIGINS=http://localhost:5173

# Frontend (set in Vercel, or in frontend/.env.local): URL of the deployed backend
# VITE_API_URL=https://pillpal-api.onrender.com
