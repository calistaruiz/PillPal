# ---------- Secrets (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Patient data (never commit real PHI) ----------
# Only synthetic test images belong in samples/. Real uploads stay local.
uploads/
user_data/
*.real.jpg
*.real.png

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Caches ----------
# Cached openFDA / RxNorm responses (regenerated automatically)
.cache/
backend/.cache/

# ---------- Editors & OS ----------
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/
